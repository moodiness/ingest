# Copy to .env; never commit passwords or real provider definitions.
# Compose interpolates these values into a URL: use URL-safe database/user names
# and a URL-safe random password (for example openssl rand -hex 24).
POSTGRES_DB=ingest
POSTGRES_USER=ingest
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Published tag without v. latest exists only after a stable release.
# For a published release candidate, set e.g. INGEST_VERSION=0.1.0-rc.1.
INGEST_VERSION=latest
INGEST_PORT=8080
# Loopback by default. Use 0.0.0.0 only for a trusted LAN; keep authentication enabled.
# Do not expose this unencrypted HTTP port to the internet.
INGEST_BIND_IP=127.0.0.1
#
# Optional: isolate a deployment without reusing another installation's volumes.
# Set these before first start; changing a name later selects different data.
# COMPOSE_PROJECT_NAME=ingest
# POSTGRES_VOLUME=ingest_postgres_data
# INGEST_STATE_VOLUME=ingest_state

# Optional: 12-72 bytes. Empty generates a random password in /data/admin-password.
# Retrieve it with: docker compose exec ingest /ingest password
INGEST_ADMIN_PASSWORD=

# Required behind an HTTPS reverse proxy, e.g. https://ingest.example.com
# An HTTPS origin is mandatory to enable catalogue sharing; keep the backend private.
INGEST_PUBLIC_URL=

# Provider credentials belong in the panel's encrypted vault, not source definitions or this file.
# Back up the PostgreSQL database AND the state volume (especially vault.key).
# Automatic encrypted backups are opt-in from Backups; save the one-time
# recovery identity outside this server and copy encrypted archives off-server.
# Docker includes matching pg_dump/pg_restore clients. Isolated restore
# verification requires CREATEDB on the configured PostgreSQL role.
# Two-step administrator verification is opt-in from Security.
